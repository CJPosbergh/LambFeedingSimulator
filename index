}
function riskNotes(A, p) {
  let prev = (st.pens.find(q => q.id === p.id) || {}).ration;
  const fromArrival = !(F.rationTotal(prev) > 0) && R() === 1;
  if (fromArrival) prev = F.arrivalDiet(); else if (!(F.rationTotal(prev) > 0)) prev = null;
  const pa = prev ? F.analyze(S(), prev) : null, jump = pa ? A.conc - pa.conc : 0, n = [];
  if (A.tot <= 0) return '';
  const ls = lambsIn(p.id), stPen = st.pens.find(q => q.id === p.id);
  const changedNow = !stPen || JSON.stringify(stPen.ration || {}) !== JSON.stringify(p.ration), stepped = p.step && changedNow;
  if (ls.length && ls.every(L => L.lastConc != null)) {
    // each lamb against the concentrate level it is used to: new arrivals came off grass, moved lambs from their old pen
    const big = ls.filter(L => A.conc - L.lastConc > 15);
    if (big.length) {
      const mx = Math.max(...big.map(L => A.conc - L.lastConc)), fresh = big.filter(L => L.dof === 0).length;
      n.push(`Concentrate is up to ${fmt(mx, 0)} points above what ${big.length === ls.length ? 'these lambs are' : big.length + ' of these lambs are'} used to${fresh ? ` (${fresh} just off grass)` : ''}${stepped ? ', stepped over 7 days' : changedNow ? ', all at once' : ', all at once: the 7-day step-in only applies when the pen\'s ration changes'}.`);
    }
  } else if (jump > 15) n.push(`Concentrate rises ${fmt(jump, 0)} percentage points from ${fromArrival ? 'the grass hay they arrived on' : 'last period'}${p.step ? ' (stepped over 7 days)' : ', all at once'}.`);
  if (A.forageNDF < 6) n.push('Very little effective fiber from forage.');
  if (A.caP < 2) n.push(`Ca:P is ${fmt(A.caP, 2)}.`);
  if (A.nh4cl < 0.4) n.push('No or little ammonium chloride.');
  if (A.s > 0.3) n.push(`Sulfur is ${fmt(A.s, 2)}% of DM.`);
  if (A.cu > 15) n.push(`Copper is ${fmt(A.cu, 0)} ppm.`);
  if (A.fat > 6) n.push(`Fat is ${fmt(A.fat, 1)}% of DM.`);
  if (A.rdp < 0.13 * A.tdn * 0.9) n.push('Rumen-degradable protein looks short of what the microbes can use.');
  return n.length ? `<div class="msg warn"><span class="ic">!</span><p><b>Check:</b> ${n.join(' ')}</p></div>` : '';
}

/* ---------- 3. health ---------- */
