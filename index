  ['ca', 'Calcium', '%', 2], ['p', 'Phosphorus', '%', 2, 'pMin', 'min'], ['caP', 'Ca:P', '', 2, 'caPMin', 'min'], ['s', 'Sulfur', '%', 2, 'sMax', 'max'], ['cu', 'Copper', 'ppm', 1, 'cuMax', 'max'], ['cuMo', 'Cu:Mo', '', 1],
