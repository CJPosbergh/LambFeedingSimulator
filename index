function parseClass(text) { let o; try { o = JSON.parse(text); } catch (e) { o = JSON.parse(decodeURIComponent(escape(atob(text)))); } if (!o || o.app !== 'bunkcall-class') throw new Error('not a class file'); return o; }
document.addEventListener('change', async e => {
