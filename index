<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Public+Sans:wght@400;500;600;700&family=Zilla+Slab:wght@500;600&display=swap">
<style>/* Layout: sticky top bar, season rail on the left (stacks above content on phones), work area with tables framed in their own scroll boxes */
:root {
  --bg: #F1F3EE; --surface: #FBFCF9; --surface-2: #E8ECE5; --ink: #1C2520; --ink-2: #48554D; --muted: #6E7C73; --line: #D2D9CF; --line-2: #BCC5BA;
  --accent: #1F5F8B; --accent-ink: #FFFFFF; --accent-soft: #DCE7F0;
  --good: #1E7438; --good-soft: #DCEEDF; --warn: #8E5B00; --warn-soft: #F5E9CF; --bad: #A93232; --bad-soft: #F5DDDA;
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100; --s5: #e87ba4; --s6: #008300; --s7: #6250d6; --s8: #e34948;
  --shadow: 0 1px 2px rgba(28, 37, 32, .06), 0 4px 16px rgba(28, 37, 32, .06);
  --font-display: 'Zilla Slab', 'Rockwell', Georgia, serif;
  --font-body: 'Public Sans', 'Segoe UI', system-ui, sans-serif;
  --font-data: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  --r: 6px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #111613; --surface: #18201B; --surface-2: #212A24; --ink: #E4EAE3; --ink-2: #B2BDB5; --muted: #8A978E; --line: #2C3730; --line-2: #3A473F;
    --accent: #7DB2DB; --accent-ink: #0D1A23; --accent-soft: #1C3243;
    --good: #72C98C; --good-soft: #193022; --warn: #E0B25B; --warn-soft: #362C16; --bad: #EE8C82; --bad-soft: #3A1E1C;
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --s5: #d55181; --s6: #008300; --s7: #9085e9; --s8: #e66767;
    --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .25);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #111613; --surface: #18201B; --surface-2: #212A24; --ink: #E4EAE3; --ink-2: #B2BDB5; --muted: #8A978E; --line: #2C3730; --line-2: #3A473F;
  --accent: #7DB2DB; --accent-ink: #0D1A23; --accent-soft: #1C3243;
  --good: #72C98C; --good-soft: #193022; --warn: #E0B25B; --warn-soft: #362C16; --bad: #EE8C82; --bad-soft: #3A1E1C;
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --s5: #d55181; --s6: #008300; --s7: #9085e9; --s8: #e66767;
  --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 4px 16px rgba(0, 0, 0, .25);
  color-scheme: dark;
}

* { box-sizing: border-box; }
html, body { background: var(--bg); color: var(--ink); }
body { font-family: var(--font-body); font-size: 14px; line-height: 1.5; }
h1, h2, h3 { font-family: var(--font-display); font-weight: 600; text-wrap: balance; margin: 0; line-height: 1.2; }
h2 { font-size: 1.55rem; }
h3 { font-size: 1.12rem; }
p { margin: 0; }
a { color: var(--accent); }
button, input, select, textarea { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.mono, .num { font-family: var(--font-data); font-variant-numeric: tabular-nums; }
.num { text-align: right; }
.muted { color: var(--muted); }
.small { font-size: .82rem; }
.eyebrow { font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; }

/* top bar */
.topbar {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
  background: var(--surface); border-bottom: 1px solid var(--line);
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; padding: 10px 16px;
}
.brand { display: flex; align-items: baseline; gap: 10px; }
.brand h1 { font-size: 1.35rem; letter-spacing: .01em; }
.brand .flock { color: var(--muted); font-size: .85rem; }
.nav { display: flex; gap: 2px; flex-wrap: wrap; }
.nav button { border: 0; background: none; padding: 6px 10px; border-radius: var(--r); cursor: pointer; color: var(--ink-2); font-weight: 500; }
.nav button:hover { background: var(--surface-2); }
.nav button[aria-current="page"] { background: var(--accent-soft); color: var(--ink); font-weight: 600; }
.season-pill { margin-left: auto; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
.kv { display: flex; flex-direction: column; line-height: 1.15; }
.kv b { font-family: var(--font-data); font-size: .95rem; font-weight: 600; }
.kv span { font-size: .7rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }

.banner { margin: 12px 16px 0; padding: 10px 14px; border-radius: var(--r); background: var(--warn-soft); color: var(--ink); display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.banner p { flex: 1 1 240px; }

/* shell */
.shell { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 20px; padding: 16px; padding-block: 16px 48px; max-width: 1500px; margin: 0 auto; }
.shell.wide { grid-template-columns: minmax(0, 1fr); }
@media (max-width: 860px) { .shell { grid-template-columns: minmax(0, 1fr); } }

.rail { display: flex; flex-direction: column; gap: 2px; position: sticky; top: 76px; align-self: start; }
.rail .yr { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 8px; }
.rail button { display: grid; grid-template-columns: 26px 1fr; gap: 8px; align-items: center; text-align: left; border: 0; background: none; padding: 7px 8px; border-radius: var(--r); cursor: pointer; color: var(--ink-2); }
.rail button .n { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--line-2); display: grid; place-items: center; font-family: var(--font-data); font-size: .72rem; }
.rail button .t { display: flex; flex-direction: column; line-height: 1.2; }
.rail button .t small { color: var(--muted); font-size: .74rem; }
.rail button:hover { background: var(--surface-2); }
.rail button[aria-current="step"] { background: var(--surface); box-shadow: var(--shadow); color: var(--ink); font-weight: 600; }
.rail button[aria-current="step"] .n { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.rail button.done .n { border-color: var(--good); color: var(--good); }
@media (max-width: 860px) {
  .rail { position: static; flex-direction: row; overflow-x: auto; gap: 4px; padding-bottom: 4px; }
  .rail .yr { display: none; }
  .rail button { grid-template-columns: 22px auto; white-space: nowrap; }
  .rail button .t small { display: none; }
}

.main { min-width: 0; display: flex; flex-direction: column; gap: 18px; }
.head { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 20px; justify-content: space-between; }
.head p { max-width: 68ch; color: var(--ink-2); margin-top: 4px; }

.panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 16px; min-width: 0; }
.panel > h3 + * { margin-top: 10px; }
.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
.grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
.stack { display: flex; flex-direction: column; gap: 10px; }
.row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.spacer { flex: 1; }

/* stat strip */
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
.stat { background: var(--surface); padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; min-width: 0; box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line); }
.stat b { font-family: var(--font-data); font-size: 1.2rem; font-weight: 600; font-variant-numeric: tabular-nums; }
.stat span { font-size: .74rem; color: var(--muted); }

/* buttons */
.btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line-2); background: var(--surface); padding: 6px 12px; border-radius: var(--r); cursor: pointer; font-weight: 500; white-space: nowrap; }
.btn:hover { background: var(--surface-2); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
.btn.primary:hover { filter: brightness(1.08); }
.btn.danger { color: var(--bad); border-color: var(--bad); }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn.sm { padding: 3px 8px; font-size: .82rem; }
input[type="number"], input[type="text"], select, textarea { background: var(--surface); border: 1px solid var(--line-2); border-radius: var(--r); padding: 5px 8px; min-width: 0; }
input[type="number"] { width: 6.5em; font-family: var(--font-data); }
textarea { width: 100%; font-family: var(--font-data); font-size: .78rem; }
label.inline { display: inline-flex; gap: 6px; align-items: center; }
.seg { display: inline-flex; border: 1px solid var(--line-2); border-radius: var(--r); overflow: hidden; }
.seg button { border: 0; background: var(--surface); padding: 5px 12px; cursor: pointer; }
.seg button + button { border-left: 1px solid var(--line-2); }
.seg button[aria-pressed="true"] { background: var(--accent-soft); font-weight: 600; }

/* tables */
.tframe { overflow: auto; max-height: 62vh; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: .82rem; }
th, td { padding: 5px 8px; border-bottom: 1px solid var(--line); white-space: nowrap; }
thead th { position: sticky; top: 0; background: var(--surface-2); z-index: 1; text-align: left; font-weight: 600; font-size: .74rem; color: var(--ink-2); cursor: pointer; user-select: none; }
thead th.num { text-align: right; }
thead th[aria-sort] { color: var(--ink); }
tbody tr:hover td { background: var(--surface-2); }
tbody tr.sel td { background: var(--accent-soft); }
tbody tr.gone td { color: var(--muted); text-decoration: line-through; }
td.tag button { border: 0; background: none; padding: 0; color: var(--accent); cursor: pointer; font-family: var(--font-data); text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 2px; }
td input[type="checkbox"], th input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--accent); }
.fav { color: var(--good); } .unf { color: var(--bad); }
.ledger td:first-child { white-space: normal; }
.ledger tr.total td { font-weight: 700; border-top: 2px solid var(--line-2); }

/* badges */
.badge { display: inline-block; padding: 1px 6px; border-radius: 4px; font-family: var(--font-data); font-size: .74rem; font-weight: 600; border: 1px solid transparent; }
.badge.good { background: var(--good-soft); color: var(--good); }
.badge.warn { background: var(--warn-soft); color: var(--warn); }
.badge.bad { background: var(--bad-soft); color: var(--bad); }
.badge.neutral { background: var(--surface-2); color: var(--ink-2); }
.badge.unk { color: var(--muted); border-color: var(--line); }
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px 2px 4px; border: 1px solid var(--line); border-radius: 999px; font-size: .8rem; }
.dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; flex: none; }

.msg { padding: 10px 12px; border-radius: var(--r); display: flex; gap: 10px; align-items: flex-start; }
.msg.err { background: var(--bad-soft); }
.msg.warn { background: var(--warn-soft); }
.msg.ok { background: var(--good-soft); }
.msg.info { background: var(--accent-soft); }
.msg .ic { font-weight: 700; font-family: var(--font-data); }

/* market cards */
.lots { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 14px; }
.lot { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.lot.bought { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.lot.gone { opacity: .55; }
.lot header { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.lot header b { font-family: var(--font-display); font-size: 1.1rem; }
.lot .price { font-family: var(--font-data); font-weight: 600; font-size: 1.05rem; }
.lot dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 10px; margin: 0; }
.lot dt { font-size: .68rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
.lot dd { margin: 0; font-family: var(--font-data); font-size: .85rem; }

/* charts */
.chart { position: relative; }
.chart svg { display: block; width: 100%; height: auto; overflow: visible; }
.chart .ttl { font-weight: 600; font-size: .88rem; margin-bottom: 2px; }
.chart .sub { font-size: .74rem; color: var(--muted); margin-bottom: 6px; }
.chart .tip { position: absolute; pointer-events: none; background: var(--ink); color: var(--bg); padding: 5px 8px; border-radius: 4px; font-size: .76rem; font-family: var(--font-data); white-space: nowrap; z-index: 3; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .78rem; color: var(--ink-2); margin-top: 4px; }
.legend i { display: inline-block; width: 16px; height: 3px; border-radius: 2px; vertical-align: middle; margin-right: 5px; }
.legend i.dash { background: repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 7px) !important; }
.charts { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }

/* drawer */
.drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(440px, 100%); background: var(--surface); border-left: 1px solid var(--line); box-shadow: var(--shadow); z-index: 40; overflow: auto; padding: 16px; padding-block: calc(16px + env(safe-area-inset-top, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)); display: flex; flex-direction: column; gap: 14px; }
.drawer header { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
.drawer h2 { font-family: var(--font-data); font-size: 1.3rem; }
.ped { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; font-size: .78rem; align-items: center; }
.ped div { border: 1px solid var(--line); border-radius: 4px; padding: 4px 6px; font-family: var(--font-data); min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.ped .self { grid-row: span 4; align-self: center; background: var(--accent-soft); }
.ped .par { grid-row: span 2; }
.accbar { height: 6px; background: var(--surface-2); border-radius: 3px; overflow: hidden; width: 70px; display: inline-block; vertical-align: middle; }
.accbar i { display: block; height: 100%; background: var(--accent); }

.overlay { position: fixed; inset: 0; background: color-mix(in srgb, var(--bg) 70%, transparent); z-index: 60; display: grid; place-items: center; }
.overlay .box { background: var(--surface); padding: 22px 28px; border-radius: var(--r); box-shadow: var(--shadow); font-family: var(--font-display); font-size: 1.2rem; text-align: center; }
.toast { position: fixed; left: 50%; transform: translateX(-50%); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); background: var(--ink); color: var(--bg); padding: 8px 14px; border-radius: var(--r); z-index: 70; font-size: .88rem; max-width: calc(100% - 32px); }

.prose { max-width: 72ch; display: flex; flex-direction: column; gap: 10px; }
.prose h3 { margin-top: 10px; }
.prose ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 4px; }
.form { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px 16px; }
.form label { display: flex; flex-direction: column; gap: 3px; font-size: .8rem; color: var(--ink-2); }
.form label input { width: 100%; }
details summary { cursor: pointer; font-weight: 600; }
@media (prefers-reduced-motion: no-preference) { .lot, .btn, .rail button { transition: background-color .15s, box-shadow .15s; } }

.ration-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 16px; }
@media (max-width: 1150px) { .ration-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
